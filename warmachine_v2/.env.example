# Copy to .env and fill in. DO NOT commit .env.
# Note: KALSHI_API_KEY_ID / KALSHI_PRIVATE_KEY_PATH are auto-loaded by
# shared/kalshi_client.py from the project-root .env — you usually only
# need to set WM_DATABASE__PASSWORD here.

# Postgres password for v2 (mirror of WARMACHINE_PG_PASSWORD in root .env)
WM_DATABASE__PASSWORD=your-pg-password

# Optional overrides
# KALSHI_API_KEY_ID=your-key-id-here
# KALSHI_PRIVATE_KEY_PATH=path/to/kalshi.pem
# WM_RUNTIME__MODE=live
